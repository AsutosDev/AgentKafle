# AgentKafle LLM configuration
# Copy this file to .env and fill in your values. Never commit .env.

# Local Ollama (default):
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2:3b
LLM_API_KEY=ollama

# Persona: optional path to a custom system prompt file (text).
# Leave empty to use the built-in detective persona defined in persona.py.
PERSONA_FILE=

# Cloud example (OpenAI):
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-your-key-here